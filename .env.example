# Firebase configuration for the existing Player-stats project.
# Copy this file to .env (local) and configure GitHub Actions secrets for deployment.
# This app ONLY reads and writes the dedicated collections: `surveys` and `survey_responses`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
